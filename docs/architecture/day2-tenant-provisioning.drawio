  <diagram name="03 Day-2 Tenant Provisioning" id="day2-tenant">
    <mxGraphModel dx="1868" dy="1198" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="1100" math="0" shadow="0">
      <root>
