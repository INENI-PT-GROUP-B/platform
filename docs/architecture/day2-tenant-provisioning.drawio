        <mxCell id="subtitle" parent="1" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;" value="&lt;span style=&quot;font-style: normal;&quot;&gt;From a tenant claim in git to a TLS-protected, BasicAuth-gated URL&lt;/span&gt;" vertex="1">
