          <mxGeometry height="970" width="440" x="800" y="90" as="geometry" />
        </mxCell>
        <mxCell id="lane-ext" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=13;fillColor=#f7faff;strokeColor=#6c8ebf;dashed=0;" value="External: GCP Secret Manager, Cloud DNS, User" vertex="1">
