        <mxCell id="p1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Phase 1 — Claim&lt;/b&gt;&lt;br&gt;Developer opens a PR&lt;br&gt;tenants/&amp;lt;name&amp;gt;.yaml&lt;br&gt;and merges it into main" vertex="1">
          <mxGeometry height="100" width="220" x="50" y="140" as="geometry" />
        </mxCell>
        <mxCell id="p2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Phase 2 — Reconcile&lt;/b&gt;&lt;br&gt;Argo CD picks up the claim&lt;br&gt;and creates the matching&lt;br&gt;XTenant resource in the cluster" vertex="1">
          <mxGeometry height="100" width="200" x="310" y="270" as="geometry" />
        </mxCell>
        <mxCell id="p3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Phase 3 — Compose&lt;/b&gt;&lt;br&gt;Crossplane matches the XTenant&lt;br&gt;to the tenant Composition&lt;br&gt;and orchestrates&lt;br&gt;the per-tenant resources" vertex="1">
          <mxGeometry height="110" width="220" x="550" y="400" as="geometry" />
        </mxCell>
        <mxCell id="p4-container" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fillColor=#f6fbf3;strokeColor=#82b366;dashed=1;" value="Phase 4 — Tenant resources come up" vertex="1">
          <mxGeometry height="370" width="420" x="810" y="540" as="geometry" />
        </mxCell>
        <mxCell id="p4a" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Namespace, ResourceQuota, LimitRange, NetworkPolicies&lt;/b&gt;&lt;br&gt;the per-tenant boundaries are set up first" vertex="1">
          <mxGeometry height="50" width="400" x="820" y="575" as="geometry" />
        </mxCell>
        <mxCell id="p4b" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Postgres database&lt;/b&gt; (CloudNativePG)&lt;br&gt;the operator provisions the DB and writes&lt;br&gt;the connection credentials into a Kubernetes Secret" vertex="1">
          <mxGeometry height="65" width="400" x="820" y="635" as="geometry" />
        </mxCell>
        <mxCell id="p4c" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;BasicAuth password&lt;/b&gt;&lt;br&gt;Crossplane generates a random password and&lt;br&gt;writes it to Google Secret Manager. ESO syncs&lt;br&gt;it back into the namespace as a Kubernetes Secret." vertex="1">
          <mxGeometry height="80" width="400" x="820" y="710" as="geometry" />
        </mxCell>
        <mxCell id="p4d" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;App Helm release&lt;/b&gt;&lt;br&gt;image tags read from values/app-version.yaml&lt;br&gt;(a per-tenant imageTagOverride wins when set)&lt;br&gt;Deployments + Services + Ingress come up;&lt;br&gt;the backend runs its DB migrations on startup" vertex="1">
          <mxGeometry height="100" width="400" x="820" y="800" as="geometry" />
        </mxCell>
        <mxCell id="p5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Phase 5 — Reachable&lt;/b&gt;&lt;br&gt;ExternalDNS publishes &amp;lt;tenant&amp;gt;.fhuebung.lol → Traefik LoadBalancer IP&lt;br&gt;Traefik serves TLS via the shared wildcard certificate&lt;br&gt;BasicAuth at the Ingress protects access · User opens the URL → 200 OK" vertex="1">
          <mxGeometry height="100" width="420" x="810" y="930" as="geometry" />
        </mxCell>
        <mxCell id="ext-gsm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Google Secret Manager&lt;/b&gt;&lt;br&gt;tenant-&amp;lt;name&amp;gt;/basicauth-htpasswd" vertex="1">
