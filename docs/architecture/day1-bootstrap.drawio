        <mxCell id="p0" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;dashed=0;verticalAlign=middle;align=center;" value="&lt;b&gt;Phase 0 — Preflight&lt;/b&gt;&lt;br&gt;gcloud / terraform / kubectl / helm present&lt;br&gt;active gcloud account + ADC&lt;br&gt;backend.tf bucket name = ${PROJECT}-tfstate&lt;br&gt;set active project" vertex="1">
